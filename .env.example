# =============================================================================
# Abdullah Mirza Portfolio — environment variables
# Copy this file to `.env.local` and fill in the values.
# =============================================================================

# OpenAI API key — powers the Aria AI chat assistant.
# Get one at https://platform.openai.com/api-keys
# When unset, the chat falls back to a deterministic rule-based responder.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Contact form email delivery (Resend) — https://resend.com/api-keys
# When RESEND_API_KEY is unset, the contact form responds with an honest
# "temporarily unavailable" message instead of silently dropping the lead.
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# Where contact-form notifications are delivered. Defaults to abdullah@mirxaa.com.
CONTACT_TO_EMAIL=

# The "from" address. Must be on a domain verified in your Resend account for
# production. Defaults to Resend's shared onboarding sender, which works on any
# account out of the box: "Portfolio Contact <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=
