{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Friendly founder-operator portfolio of Abdullah Mirza — apps, AI tools, logistics, and commerce from Riyadh.",
  "author": "Abdullah Mirza",
  "license": "ISC",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:deploy": "pnpm type-check && pnpm lint && pnpm test && pnpm build"
  },
  "keywords": [
    "portfolio",
    "next.js",
    "react",
    "typescript",
    "tailwindcss"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "framer-motion": "^12.34.4",
    "lucide-react": "^0.576.0",
    "next": "^16.1.6",
    "openai": "^6.34.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.14.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.8",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.1"
  }
}
